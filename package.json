{
  "name": "characterforge",
  "private": true,
  "version": "0.6.0",
  "description": "2D-first, 3D-guided manga character posing and illustration studio: character profiles, a Three.js pose mannequin, and a pluggable local generation backend.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
