    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "ag-psd": ">=22.0.0",
    "dexie": "^4.0.0",
    "fflate": "^0.8.0",
    "pixi.js": "^8.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.49.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
